# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/case_manager?sslmode=require"

# Required for auth (NextAuth) — generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Required for CourtListener research and RECAP docket imports
COURTLISTENER_API_TOKEN=""

# Optional alternate token for RECAP imports (used if COURTLISTENER_API_TOKEN is empty)
RECAP_API_TOKEN=""
