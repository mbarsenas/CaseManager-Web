# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/case_manager?sslmode=require"

# Required for auth (NextAuth) — generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional — CourtListener works without a token, but a free account raises rate limits
COURTLISTENER_API_TOKEN=""

# Optional — only needed once you wire up the RECAP API call in app/api/pacer/route.ts
RECAP_API_TOKEN=""
